# Copie para `.env` (ignorado pelo git) e ajuste. Nenhum valor daqui é secreto.

# --- obrigatórias -----------------------------------------------------------
# Banco de desenvolvimento. NUNCA use este mesmo banco no e2e: a suíte apaga tudo.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/contafacil_dev
# Chave de cifra dos segredos (senhas gov.br, NFS-e, credenciais, tokens de
# provedores). 32 bytes em base64url. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Em produção vem de um secret; perder a chave = perder as senhas cifradas.
CHAVE_CIFRA=troque-esta-chave-de-desenvolvimento-por-uma-de-32-bytes

# --- API --------------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Limites do login (falhas por 15 minutos). O limite por login vale também
# entre instâncias (tabela `tentativas_login`).
LOGIN_TENTATIVAS_POR_IP=30
LOGIN_TENTATIVAS_POR_LOGIN=10
# Sessão parada mais que isto cai, mesmo dentro dos 30 dias de validade.
SESSAO_INATIVIDADE_HORAS=12
# Pool do Postgres
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
# Token que autoriza `POST /api/jobs/executar` (o agendador externo chama com
# `Authorization: Bearer <token>` a cada 5 minutos). Sem ele a rota responde 503.
TOKEN_JOBS=
# Onde há processo permanente (Docker/dev), a própria API pode puxar a fila a
# cada N segundos. 0 = desligado (autoscale: use o agendador externo).
JOBS_INTERVALO_S=0
# Quanto tempo uma rodada de POST /api/jobs/executar processa, no máximo.
JOBS_TEMPO_MAX_MS=240000
# URL pública do sistema, usada nos links enviados ao cliente (protocolos,
# portal, redefinição de senha)
URL_PUBLICA=http://localhost:5173

# --- primeiro escritório (só no primeiro boot com banco vazio) ----------------
# Quando o banco não tem nenhuma conta, a API cria esta e o catálogo padrão.
# Depois do primeiro boot estas variáveis podem ser removidas.
BOOTSTRAP_CONTA_NOME=
BOOTSTRAP_LOGIN=
BOOTSTRAP_SENHA=

# --- front (Vite) -----------------------------------------------------------
# PORT e BASE_PATH são obrigatórias para o `vite` subir.
# PORT=5173
# BASE_PATH=/
# Em dev, o proxy `/api` aponta para a API local.
# API_PROXY_TARGET=http://localhost:8080

# --- e2e --------------------------------------------------------------------
# Banco só para testes; precisa ter "test" ou "e2e" no nome.
E2E_DATABASE_URL=postgres://postgres@127.0.0.1:5432/contafacil_e2e
# Chromium alternativo (Replit/Nix). Vazio usa o do Playwright.
# REPLIT_PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- serviços externos (opcionais; sem eles a API usa implementações locais) ---
# Armazenamento de arquivos compatível com S3 (Cloudflare R2): o navegador sobe
# e baixa direto por URL assinada. Sem R2_*, os arquivos vão para o disco local
# (DADOS_LOCAIS_DIR, padrão ./dados-locais) e passam pela API — só para dev.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# DADOS_LOCAIS_DIR=./dados-locais
# E-mail transacional. Sem RESEND_API_KEY, os e-mails ficam registrados na
# tabela `avisos` sem envio (dev/e2e).
RESEND_API_KEY=
EMAIL_REMETENTE=ContaFácil <avisos@exemplo.com.br>
# WhatsApp Cloud API (Meta). Sem estas, a cobrança usa o link wa.me manual.
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSAO=v21.0
# Cobrança (Asaas). Sem ASAAS_API_KEY, os honorários não geram cobrança externa.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
ASAAS_WEBHOOK_TOKEN=
